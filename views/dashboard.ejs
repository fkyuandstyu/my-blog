<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title><%= user.username %> 的文章列表</title>
</head>
<body>
  <h1>👋 歡迎回來，<%= user.username %></h1>
  <h2>你的文章：</h2>

  <% if (posts.length === 0) { %>
    <p>目前沒有文章。</p>
  <% } else { %>
    <ul>
      <% posts.forEach(post => { %>
        <li>
          <strong><%= post.title %></strong><br>
          <small>發佈時間：<%= post.created_at.toLocaleString() %></small>
        </li>
      <% }); %>
    </ul>
  <% } %>

  <p><a href="/post">✍️ 新增文章</a></p>
  <p><a href="/logout">🚪 登出</a></p>
</body>
</html>
